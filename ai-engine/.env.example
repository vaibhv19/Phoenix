#################################################
# Service Server
#################################################

# Port for the FastAPI server to bind to
PORT=8000

#################################################
# Database
#################################################

# PostgreSQL connection URL (must align with Spring Boot configuration)
DATABASE_URL=postgresql://your_database_username:your_database_password@localhost:5432/phoenix

#################################################
# AI Models & Providers
#################################################

# LLM provider configuration (ollama | mock)
LLM_PROVIDER=ollama

# Neural reranker provider configuration (flashrank | mock)
RERANKER_PROVIDER=flashrank

# Base URL of the local Ollama LLM provider server
OLLAMA_URL=http://localhost:11434

# Deployed model name inside Ollama
OLLAMA_MODEL=mistral

# Model name used by FlashRank neural Cross-Encoder
FLASHRANK_MODEL=ms-marco-MiniLM-L-6-v2

# SentenceTransformer embedding model name (for pgvector generation)
EMBEDDING_MODEL=all-MiniLM-L6-v2
